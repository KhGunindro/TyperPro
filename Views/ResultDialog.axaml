<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TyperPro.ViewModels"
        x:Class="TyperPro.Views.ResultDialog"
        Title="Test Results"
        Width="1000"
        Height="800"
        WindowStartupLocation="CenterOwner"
        Background="#121212"
        FontFamily="{StaticResource JetBrainsFont}">

    <Window.DataContext>
        <vm:ResultViewModel />
    </Window.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#81C784"/>
        </Style>
        <Style Selector="Border.statBox">
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="BorderBrush" Value="#2E7D32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12 8"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Styles>

    <Grid Margin="20" RowDefinitions="Auto,*,Auto">
        <TextBlock Text="Session Results" FontSize="24" FontWeight="Bold" Foreground="#4CAF50"
                   HorizontalAlignment="Center" Margin="0 0 0 20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <!-- First row: WPM, ACC, RAW, Consistency -->
                <WrapPanel HorizontalAlignment="Center">
                    <Border Classes="statBox">
                        <StackPanel>
                            <TextBlock Text="WPM" FontSize="14" Opacity="0.7"/>
                            <TextBlock Text="{Binding Wpm, StringFormat={}{0:F0}}" 
                                       FontSize="28" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="statBox">
                        <StackPanel>
                            <TextBlock Text="ACC" FontSize="14" Opacity="0.7"/>
                            <TextBlock Text="{Binding Accuracy, StringFormat={}{0:F0}%}" 
                                       FontSize="28" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="statBox">
                        <StackPanel>
                            <TextBlock Text="RAW" FontSize="14" Opacity="0.7"/>
                            <TextBlock Text="{Binding RawWpm, StringFormat={}{0:F0}}" 
                                       FontSize="28" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="statBox">
                        <StackPanel>
                            <TextBlock Text="CONSISTENCY" FontSize="14" Opacity="0.7"/>
                            <TextBlock Text="{Binding Consistency, StringFormat={}{0:F0}%}" 
                                       FontSize="28" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Second row: character stats (now with words) -->
                <WrapPanel HorizontalAlignment="Center">
                    <Border Classes="statBox">
                        <StackPanel>
                            <TextBlock Text="Correct" FontSize="14" Opacity="0.7"/>
                            <TextBlock Text="{Binding CorrectChars}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="statBox">
                        <StackPanel>
                            <TextBlock Text="Incorrect" FontSize="14" Opacity="0.7"/>
                            <TextBlock Text="{Binding IncorrectChars}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="statBox">
                        <StackPanel>
                            <TextBlock Text="Missed" FontSize="14" Opacity="0.7"/>
                            <TextBlock Text="{Binding MissedChars}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="statBox">
                        <StackPanel>
                            <TextBlock Text="Extra" FontSize="14" Opacity="0.7"/>
                            <TextBlock Text="{Binding ExtraChars}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Test info -->
                <WrapPanel HorizontalAlignment="Center">
                    <Border Classes="statBox" Padding="12 4">
                        <TextBlock Text="{Binding TestType}" FontSize="16"/>
                    </Border>
                    <Border Classes="statBox" Padding="12 4">
                        <TextBlock Text="{Binding Time}" FontSize="16"/>
                    </Border>
                    <Border Classes="statBox" Padding="12 4">
                        <TextBlock Text="{Binding SessionDuration, StringFormat='Session: {0}'}" 
                                   FontSize="16"/>
                    </Border>
                </WrapPanel>

                <!-- Graph area -->
                <Border Background="#181818" BorderBrush="#2E7D32" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Performance Graph" FontSize="16" Margin="0 0 0 8"/>
                        <Canvas Name="GraphCanvas" Height="200" Background="#0A0A0A" ClipToBounds="True"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Close" HorizontalAlignment="Center" Width="100" Margin="0 20 0 0"
                Click="CloseButton_Click"/>
    </Grid>
</Window>