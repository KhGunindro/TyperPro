<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TyperPro.Views.SummaryWindow"
        Title="TyperPro — Summary"
        Width="1100" Height="720"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D"
        FontFamily="Courier New, Courier, monospace">

    <Window.Styles>
        <Style Selector="Border.topBar">
            <Setter Property="Height" Value="2"/>
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="3"/>
        </Style>
        <Style Selector="TextBlock.bigValue">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="FontFamily" Value="Courier New, Courier, monospace"/>
        </Style>
        <Style Selector="TextBlock.unit">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#2A2A2A"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="3 0 0 6"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#1A1A1A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="20 16"/>
        </Style>
        <Style Selector="Button.close">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="FontFamily" Value="Courier New, Courier, monospace"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderBrush" Value="#1E1E1E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="28 11"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style Selector="Button.close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="TextElement.Foreground" Value="#888888"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Border Classes="topBar"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0 2 0 0">
            <StackPanel Margin="48 36 48 48" Spacing="0">

                <!-- Hero -->
                <StackPanel x:Name="HeroPanel" Opacity="0" Margin="0 0 0 40">
                    <StackPanel.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.5" Easing="CubicEaseOut"/>
                        </Transitions>
                    </StackPanel.Transitions>
                    <TextBlock Text="SESSION COMPLETE"
                               FontSize="10" FontWeight="Bold"
                               Foreground="#4CAF50" LetterSpacing="6"
                               Margin="0 0 0 10"/>
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0 0 0 6">
                        <TextBlock Text="well done," FontSize="36" FontWeight="Bold" Foreground="#444444"/>
                        <TextBlock x:Name="PlayerNameText" FontSize="36" FontWeight="Bold" Foreground="#E8E8E8"/>
                        <TextBlock Text="." FontSize="36" FontWeight="Bold" Foreground="#4CAF50"/>
                    </StackPanel>
                    <TextBlock x:Name="TaglineText" FontSize="13" Foreground="#2A2A2A" LetterSpacing="1"/>
                </StackPanel>

                <!-- Overall averages -->
                <TextBlock Classes="label" Text="OVERALL AVERAGE" Margin="0 0 0 12"/>
                <Grid ColumnDefinitions="*,*,*,*" Margin="0 0 0 32">
                    <Border Grid.Column="0" Classes="card" Margin="0 0 6 0">
                        <StackPanel>
                            <TextBlock Classes="label" Text="AVG WPM"/>
                            <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
                                <TextBlock x:Name="AvgWpmText" Classes="bigValue"/>
                                <TextBlock Classes="unit" Text="wpm"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card" Margin="6 0 6 0">
                        <StackPanel>
                            <TextBlock Classes="label" Text="AVG RAW"/>
                            <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
                                <TextBlock x:Name="AvgRawText" Classes="bigValue" Foreground="#666666"/>
                                <TextBlock Classes="unit" Text="wpm"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="card" Margin="6 0 6 0">
                        <StackPanel>
                            <TextBlock Classes="label" Text="AVG ACC"/>
                            <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
                                <TextBlock x:Name="AvgAccText" Classes="bigValue"/>
                                <TextBlock Classes="unit" Text="%"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Classes="card" Margin="6 0 0 0">
                        <StackPanel>
                            <TextBlock Classes="label" Text="BEST WPM"/>
                            <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
                                <TextBlock x:Name="BestWpmText" Classes="bigValue" Foreground="#4CAF50"/>
                                <TextBlock Classes="unit" Text="wpm"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Per-round breakdown (built in code-behind) -->
                <TextBlock Classes="label" Text="ROUND BREAKDOWN" Margin="0 0 0 12"/>
                <Grid x:Name="RoundCardsGrid" ColumnDefinitions="*,*,*" Margin="0 0 0 32"/>

                <!-- Charts -->
                <TextBlock Classes="label" Text="OVERALL PERFORMANCE" Margin="0 0 0 12"/>
                <Grid ColumnDefinitions="*,*" Margin="0 0 0 32">
                    <Border Grid.Column="0" Classes="card" Margin="0 0 6 0">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="0 0 0 12">
                                <TextBlock Classes="label" Text="AVG WPM OVER TIME" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Border Width="12" Height="2" Background="#4CAF50" VerticalAlignment="Center"/>
                                    <TextBlock Text="avg wpm" FontSize="9" Foreground="#333333"/>
                                </StackPanel>
                            </Grid>
                            <Canvas x:Name="WpmGraphCanvas" Height="140" Background="Transparent"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card" Margin="6 0 0 0">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="0 0 0 12">
                                <TextBlock Classes="label" Text="AVG ERROR RATE" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Border Width="12" Height="2" Background="#F44336" VerticalAlignment="Center"/>
                                    <TextBlock Text="error %" FontSize="9" Foreground="#333333"/>
                                </StackPanel>
                            </Grid>
                            <Canvas x:Name="ErrorGraphCanvas" Height="140" Background="Transparent"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Button Classes="close" HorizontalAlignment="Right"
                        Click="CloseButton_Click" Content="CLOSE  ×"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>