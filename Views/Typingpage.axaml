<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TyperPro.Views.TypingPage"
             x:CompileBindings="False"
             FontFamily="Courier New, Courier, monospace">

    <UserControl.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#0A0A0F" Offset="0"/>
            <GradientStop Color="#0D0D12" Offset="0.5"/>
            <GradientStop Color="#080810" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <UserControl.Styles>

        <Style Selector="Border.cursor">
            <Setter Property="Background" Value="#4ADE80"/>
            <Setter Property="Width" Value="2"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Style.Animations>
                <Animation Duration="0:0:0.85" IterationCount="Infinite">
                    <KeyFrame Cue="0%">  <Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="45%"> <Setter Property="Opacity" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="TextBlock.statLabel">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="#606080"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="3"/>
        </Style>

        <Style Selector="TextBlock.statValue">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Segoe UI Mono, monospace"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Foreground" Value="#020D02"/>
            <Setter Property="FontFamily" Value="Courier New, Courier, monospace"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="32 12"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#4ADE80" Offset="0"/>
                        <GradientStop Color="#22C55E" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#6EE7A0" Offset="0"/>
                        <GradientStop Color="#4ADE80" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#0F1F0F"/>
            <Setter Property="TextElement.Foreground" Value="#1A3A1A"/>
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#3A3A4A"/>
            <Setter Property="FontFamily" Value="Courier New, Courier, monospace"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderBrush" Value="#1E1E2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="32 12"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0F0F18"/>
            <Setter Property="TextElement.Foreground" Value="#6A6A8A"/>
        </Style>
        <Style Selector="Button.ghost:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextElement.Foreground" Value="#1A1A24"/>
        </Style>

    </UserControl.Styles>

    <Panel>

        <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="52 28 52 0">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*" Margin="0 0 0 20">

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="TYPER"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#4ADE80" LetterSpacing="5"
                                   FontFamily="Courier New, Courier, monospace"/>
                        <Border Width="4" Height="4" CornerRadius="2"
                                Background="#4ADE80" VerticalAlignment="Center"/>
                        <TextBlock Text="PRO"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#2A6A40" LetterSpacing="5"
                                   FontFamily="Courier New, Courier, monospace"/>
                    </StackPanel>
                    <TextBlock Text="{Binding RoundDisplay}"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#ECECEC"
                               FontFamily="Courier New, Courier, monospace"/>
                </StackPanel>

                <Panel Grid.Column="1" Width="84" Height="84" HorizontalAlignment="Center">
                    <Border CornerRadius="42" BorderThickness="1" Opacity="0.25">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#4ADE80" Offset="0"/>
                                <GradientStop Color="#22C55E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                    </Border>
                    <Border Width="74" Height="74" CornerRadius="37" BorderThickness="2"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#1A2E1A" Offset="0"/>
                                <GradientStop Color="#0F1F0F" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#060910" Offset="0"/>
                                <GradientStop Color="#050708" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding RemainingSeconds}"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="#F0F0F0" HorizontalAlignment="Center"
                                       FontFamily="Cascadia Code, Consolas, Segoe UI Mono, monospace"/>
                            <TextBlock Text="{Binding CountdownLabel}"
                                       FontSize="7" Foreground="#4A6A4A"
                                       HorizontalAlignment="Center" LetterSpacing="1"/>
                        </StackPanel>
                    </Border>
                </Panel>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10">

                    <Border Padding="16 10" CornerRadius="6" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Color="#0C0C14" Offset="0"/>
                                <GradientStop Color="#090910" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Color="#1E1E2E" Offset="0"/>
                                <GradientStop Color="#12121A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Classes="statLabel" Text="WPM" HorizontalAlignment="Center"/>
                            <TextBlock Classes="statValue"
                                       Text="{Binding Wpm, StringFormat='{}{0:F0}'}"
                                       Foreground="#4ADE80"/>
                        </StackPanel>
                    </Border>

                    <Border Padding="16 10" CornerRadius="6" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Color="#0C0C14" Offset="0"/>
                                <GradientStop Color="#090910" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Color="#1E1E2E" Offset="0"/>
                                <GradientStop Color="#12121A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Classes="statLabel" Text="ACC" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="statValue"
                                           Text="{Binding Accuracy, StringFormat='{}{0:F0}'}"
                                           Foreground="#F0F0F0"/>
                                <TextBlock FontSize="13" Foreground="#3A3A4A"
                                           VerticalAlignment="Bottom" Margin="2 0 0 4"
                                           FontFamily="Courier New">%</TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Padding="16 10" CornerRadius="6" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Color="#0C0C14" Offset="0"/>
                                <GradientStop Color="#090910" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Color="#1E1E2E" Offset="0"/>
                                <GradientStop Color="#12121A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Classes="statLabel" Text="RESETS" HorizontalAlignment="Center"/>
                            <TextBlock Classes="statValue"
                                       Text="{Binding AttemptsLeft}"
                                       Foreground="#F97316" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

            <Border Grid.Row="1" CornerRadius="8" BorderThickness="1" Padding="36 30">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#07070E" Offset="0"/>
                        <GradientStop Color="#060609" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#1E1E30" Offset="0"/>
                        <GradientStop Color="#12121C" Offset="0.5"/>
                        <GradientStop Color="#1A1A2A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>

                <Grid RowDefinitions="*,Auto">
                    <ItemsControl Grid.Row="0"
                                  ItemsSource="{Binding FormattedText}"
                                  VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding Character}"
                                               FontSize="21"
                                               FontFamily="{StaticResource JetBrainsFont}"
                                               Foreground="{Binding Foreground}"
                                               Margin="0 0 0.4 0"
                                               LineHeight="36"/>
                                    <Border Classes.cursor="{Binding IsCaret}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Row="1"
                               Text="· click here and start typing ·"
                               FontSize="9" Foreground="#2A2A3A"
                               HorizontalAlignment="Center" Margin="0 18 0 0"
                               LetterSpacing="3"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0 18 0 0">
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="EASY" FontSize="8" LetterSpacing="2"
                               Foreground="#505068" VerticalAlignment="Center"/>
                    <Border Width="7" Height="7" CornerRadius="4">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#4ADE80" Offset="0"/>
                                <GradientStop Color="#22C55E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border Width="7" Height="7" CornerRadius="4" Background="#1A1A28"/>
                    <Border Width="7" Height="7" CornerRadius="4" Background="#1A1A28"/>
                    <Border Width="1" Height="12" Background="#1A1A28"
                            VerticalAlignment="Center" Margin="4 0"/>
                    <TextBlock Text="MED" FontSize="8" LetterSpacing="2"
                               Foreground="#303048" VerticalAlignment="Center"/>
                    <Border Width="7" Height="7" CornerRadius="4" Background="#1A1A28"/>
                    <Border Width="7" Height="7" CornerRadius="4" Background="#1A1A28"/>
                    <Border Width="7" Height="7" CornerRadius="4" Background="#1A1A28"/>
                    <Border Width="1" Height="12" Background="#1A1A28"
                            VerticalAlignment="Center" Margin="4 0"/>
                    <TextBlock Text="HARD" FontSize="8" LetterSpacing="2"
                               Foreground="#303048" VerticalAlignment="Center"/>
                    <Border Width="7" Height="7" CornerRadius="4" Background="#1A1A28"/>
                    <Border Width="7" Height="7" CornerRadius="4" Background="#1A1A28"/>
                    <Border Width="7" Height="7" CornerRadius="4" Background="#1A1A28"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Classes="ghost"   Content="RESET" Command="{Binding ResetCommand}"/>
                    <Button Classes="primary" Content="START" Command="{Binding StartCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ── COUNTDOWN OVERLAY — IsHitTestVisible=False so it never blocks input ── -->
        <Border IsVisible="{Binding CountdownOverlayVisible}"
                IsHitTestVisible="False"
                CornerRadius="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                    <GradientStop Color="#F2060610" Offset="0"/>
                    <GradientStop Color="#F0050510" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="0">
                <TextBlock Text="GET  READY"
                           FontSize="11" FontWeight="Bold" Foreground="#3A5A3A"
                           HorizontalAlignment="Center" LetterSpacing="10"
                           Margin="0 0 0 6"/>
                <TextBlock Text="{Binding CountdownValue}"
                           FontSize="130" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           FontFamily="Cascadia Code, Consolas, Segoe UI Mono, monospace"
                           LineHeight="128">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#6EE7A0" Offset="0"/>
                            <GradientStop Color="#4ADE80" Offset="0.4"/>
                            <GradientStop Color="#22C55E" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
                <Border Height="2" Width="80" CornerRadius="1"
                        HorizontalAlignment="Center" Margin="0 10 0 0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#22C55E"   Offset="0.5"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <TextBlock Text="60  SECOND  ROUND"
                           FontSize="9" Foreground="#3A5A3A"
                           HorizontalAlignment="Center" LetterSpacing="6"
                           Margin="0 12 0 0"/>
            </StackPanel>
        </Border>

    </Panel>

</UserControl>