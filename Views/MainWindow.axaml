<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TyperPro.ViewModels"
        x:Class="TyperPro.Views.MainWindow"
        Width="960"
        Height="560"
        Background="#121212"
        Title="TyperPro">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="40" RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <TextBlock Text="TyperPro"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="#4CAF50"/>

        <!-- Main card -->
        <Border Grid.Row="1"
                Margin="0,28"
                Padding="28"
                CornerRadius="20"
                Background="#181818"
                BorderBrush="#2E7D32"
                BorderThickness="1"
                BoxShadow="0 20 40 #00000066">

            <StackPanel Spacing="24">

                <!-- Animated sentence -->
                <ItemsControl ItemsSource="{Binding FormattedText}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Character}"
                                       FontSize="21"
                                       Foreground="{Binding Foreground}"
                                       Classes="char"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Input -->
                <TextBox Text="{Binding InputText}"
                         FontSize="22"
                         CaretBrush="#4CAF50"
                         Background="#141414"
                         BorderBrush="#2E7D32"
                         CornerRadius="14"
                         Padding="16"
                         Watermark="start typing…"/>

                <!-- Stats -->
                <StackPanel Orientation="Horizontal" Spacing="32">
                    <TextBlock Text="{Binding Wpm, StringFormat='WPM {0}'}"
                               Foreground="#81C784"/>
                    <TextBlock Text="{Binding Accuracy, StringFormat='ACC {0}%'}"
                               Foreground="#81C784"/>
                    <TextBlock Text="{Binding RemainingSeconds, StringFormat='TIME {0}s'}"
                               Foreground="#81C784"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Controls -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="16">
            <Button Content="Start" Command="{Binding StartCommand}"/>
            <Button Content="Reset" Command="{Binding ResetCommand}"/>
        </StackPanel>

    </Grid>
</Window>
