<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TyperPro.Views.MainWindow"
        Width="960" Height="640" MinWidth="900"
        Background="#0A0A0A"
        Title="TyperPro"
        Focusable="True"
        FontFamily="Cascadia Code, Consolas, Segoe UI Mono, monospace"
        Icon="/Assets/Favicon_200x200.png">

    <Window.Styles>
        <Style Selector="Border.cursor">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Width" Value="2"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0 4 0 0"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame Cue="0%"> <Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="20 10"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Background" Value="#1B5E20"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto">
        <ContentControl x:Name="PageHost" Grid.Row="0"/>
        <Border Grid.Row="1" Background="#080808" BorderBrush="#111111" BorderThickness="0 1 0 0">
            <Grid ColumnDefinitions="*,Auto,*" Margin="32 0">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="10"
                            Height="38">
                    <Border Width="6" Height="6"
                            CornerRadius="3"
                            Background="#4CAF50"
                            VerticalAlignment="Center">
                        <Border.Styles>
                            <Style Selector="Border">
                                <Style.Animations>
                                    <Animation Duration="0:0:2" IterationCount="Infinite">
                                        <KeyFrame Cue="0%">  <Setter Property="Opacity" Value="1"/></KeyFrame>
                                        <KeyFrame Cue="50%"> <Setter Property="Opacity" Value="0.3"/></KeyFrame>
                                        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Border.Styles>
                    </Border>
                    <TextBlock Text="NIELIT IMPHAL"
                               FontSize="10" FontWeight="Bold"
                               Foreground="#666666" LetterSpacing="3"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="6" Height="38">
                    <TextBlock Text="developed by" FontSize="9"
                               Foreground="#444444" VerticalAlignment="Center"/>
                    <TextBlock Text="KhGunindro" FontSize="9" FontWeight="Bold"
                               Foreground="#4CAF50" VerticalAlignment="Center"
                               Opacity="0.9"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="6" Height="38">
                    <TextBlock Text="©" FontSize="9"
                               Foreground="#444444" VerticalAlignment="Center"/>
                    <TextBlock Text="2026" FontSize="9" FontWeight="Bold"
                               Foreground="#555555" VerticalAlignment="Center"
                               LetterSpacing="2"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>