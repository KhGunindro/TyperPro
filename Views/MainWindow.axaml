<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TyperPro.Views.MainWindow"
        Width="960"
        Height="600"
        Background="#121212"
        Title="TyperPro"
        Focusable="True"
        Loaded="OnLoaded"
        PointerPressed="OnPointerPressed">

    <Window.Styles>
        <Style Selector="Border.cursor">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Width" Value="2"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0 4 0 0"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="20 10"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Background" Value="#1B5E20"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <Style Selector="Border.statBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#2E7D32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16 10"/>
            <Setter Property="Margin" Value="6"/>
        </Style>
    </Window.Styles>

    <!-- Single ContentControl — code-behind swaps between TypingPage and ResultPage -->
    <ContentControl x:Name="PageHost"/>

</Window>