<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TyperPro.Views.NameInputDialog"
        Title="TyperPro"
        Width="460" Height="280"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="#0D0D0D"
        FontFamily="Courier New, Courier, monospace"
        SystemDecorations="BorderOnly"
        TransparencyLevelHint="None">

    <Window.Styles>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#0A0A0A"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="CaretBrush" Value="#4CAF50"/>
            <Setter Property="BorderBrush" Value="#1E1E1E"/>
            <Setter Property="BorderThickness" Value="0 0 0 1"/>
            <Setter Property="FontFamily" Value="JetBrains Mono, Cascadia Code, Consolas, monospace"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="0 8"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#4CAF50"/>
        </Style>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Button.submit">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="#0D0D0D"/>
            <Setter Property="FontFamily" Value="Courier New, Courier, monospace"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="32 12"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style Selector="Button.submit:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#66BB6A"/>
        </Style>
        <Style Selector="Button.submit:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A2E1A"/>
            <Setter Property="TextElement.Foreground" Value="#2A4A2A"/>
        </Style>

    </Window.Styles>

    <Grid>

        <!-- Subtle top accent line -->
        <Border Height="2"
                Background="#4CAF50"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                Opacity="0.6"/>

        <StackPanel VerticalAlignment="Center"
                    Margin="48 0 48 0"
                    Spacing="0"
                    x:Name="ContentPanel"
                    Opacity="0">

            <!-- Animate in on load -->
            <StackPanel.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="CubicEaseOut"/>
                </Transitions>
            </StackPanel.Transitions>

            <!-- Brand -->
            <StackPanel Margin="0 0 0 28">
                <TextBlock Text="TYPERPRO"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#4CAF50"
                           LetterSpacing="6"/>
                <TextBlock Text="enter your name"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#E8E8E8"
                           Margin="0 6 0 0"/>
            </StackPanel>

            <!-- Input -->
            <TextBox x:Name="NameTextBox"
                     Watermark="player_one"
                     MaxLength="24"/>

            <TextBlock x:Name="ErrorText"
                       Text="name cannot be empty"
                       FontSize="10"
                       Foreground="#F44336"
                       LetterSpacing="1"
                       Margin="0 8 0 0"
                       IsVisible="False"/>

            <!-- Button row -->
            <Grid ColumnDefinitions="*,Auto" Margin="0 28 0 0">
                <TextBlock Grid.Column="0"
                           Text="press enter or click →"
                           FontSize="9"
                           Foreground="#222222"
                           LetterSpacing="1"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Classes="submit"
                        x:Name="StartBtn"
                        Click="StartGame_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="START" VerticalAlignment="Center"/>
                        <TextBlock Text="→" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

        </StackPanel>
    </Grid>
</Window>